{
  "name": "gald-lang",
  "displayName": "Gald Language",
  "description": "Syntax highlighting and language support for Gald — a statically-dispatched Objective-C dialect",
  "version": "0.2.0",
  "publisher": "gald-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gald",
        "aliases": [
          "Gald",
          "gald",
          ".gm"
        ],
        "extensions": [
          ".gm",
          ".gh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gald",
        "scopeName": "source.gm",
        "path": "./syntaxes/gald.tmLanguage.json"
      }
    ]
  }
}
