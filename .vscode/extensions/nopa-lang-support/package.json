{
  "name": "ovic-lang",
  "displayName": "Ovic Language",
  "description": "Syntax highlighting and language support for Ovic — a statically-dispatched Objective-C dialect",
  "version": "0.2.0",
  "publisher": "ovic-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ovic",
        "aliases": [
          "Ovic",
          "ovic",
          ".ov"
        ],
        "extensions": [
          ".ov",
          ".oh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ovic",
        "scopeName": "source.ov",
        "path": "./syntaxes/ovic.tmLanguage.json"
      }
    ]
  }
}
