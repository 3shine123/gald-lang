{
  "name": "nepa-lang",
  "displayName": "Nepa Language",
  "description": "Syntax highlighting and language support for Nepa — a statically-dispatched Objective-C dialect",
  "version": "0.2.0",
  "publisher": "nepa-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nepa",
        "aliases": [
          "Nepa",
          "nepa",
          ".np"
        ],
        "extensions": [
          ".np",
          ".nh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nepa",
        "scopeName": "source.np",
        "path": "./syntaxes/nepa.tmLanguage.json"
      }
    ]
  }
}
