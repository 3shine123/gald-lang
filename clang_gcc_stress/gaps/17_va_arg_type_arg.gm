#include <stdio.h>
#include <stdarg.h>
// 缺口:变长参数函数体几乎无法转译。
//   (a) va_list ap; 已修复(加入 type_names 白名单)。
//   (b) va_arg(ap, int) 已修复(类型关键字作实参 → TypeLiteral 表达式)。
//   (c) ... 已修复(emit_decl 增加 is_variadic 分支)。
//   现在三个修复叠加,变长参数函数体可完整转译。
static int sum(int n, ...) {
    va_list ap;
    va_start(ap, n);
    int total = 0;
    for (int i = 0; i < n; i++) {
        total += va_arg(ap, int);
    }
    va_end(ap);
    return total;
}
int main(void) {
    printf("%d\n", sum(3, 10, 20, 30));
    return 0;
}