// json_editor_types.gh — Gald 全特性 JSON 编辑器 · 类型声明
#import <Foundation/Foundation.gm>

@namespace JSON

    @protocol Value
        - (const char *)typeName;
        - (void)printOn:(int)indent;
        - (id)copyValue;
    @end

    @interface Error : NFObject {
        char *_message;
    }
        - (instancetype)initWithMessage:(const char *)msg;
        - (const char *)message;
        - (void)dealloc;
    @end

    @interface Null : NFObject <Value>
        + (id)sharedNull;
    @end

    @interface Bool : NFObject <Value> {
        BOOL _value;
    }
        - (instancetype)initWithBool:(BOOL)val;
        @property BOOL value;
    @end

    @interface Number : NFObject <Value> {
        double _value;
    }
        - (instancetype)initWithDouble:(double)val;
        - (instancetype)initWithInt:(int)val;
        @property double value;
    @end

    @interface String : NFObject <Value> {
        char *_value;
    }
        - (instancetype)initWithString:(const char *)val;
        - (void)dealloc;
        @property (assign) const char *value;
    @end

    @interface Array : NFObject <Value> {
        @public
        id *_items; int _count; int _capacity;
    }
        - (instancetype)init;
        - (void)dealloc;
        - (int)count;
        - (id)at:(int)idx;
        - (void)add:(id)val;
        - (void)removeAt:(int)idx;
        - (void)each:(void (^)(int idx, id val))block;
    @end

    @interface Object : NFObject <Value> {
        @public
        char **_keys; id *_values; int _count; int _capacity;
    }
        - (instancetype)init;
        - (void)dealloc;
        - (int)count;
        - (id)get:(const char *)key;
        - (void)set:(id)val forKey:(const char *)key;
        - (void)remove:(const char *)key;
        - (const char *)atKey:(int)idx;
        - (id)atVal:(int)idx;
        - (void)each:(void (^)(int idx, id val))block;
    @end

    @interface Parser : NFObject
        + (id)parse:(const char *)input;
    @end

    @interface Editor : NFObject {
        @public
        id _root; BOOL _running; char _inputBuf[4096];
        int _histCount;
        char _histCmds[128000];
        char _histOut[256000];
        int _histCount;
    }
        - (instancetype)init;
        - (void)dealloc;
        - (void)run;
    @end

@endnamespace // @namespace JSON

@interface Buffer<T> : NFObject {
    T _storage[16]; int _count;
}
    - (instancetype)init;
    - (void)push:(T)item;
    - (T)get:(int)index;
    - (int)count;
@end

@interface Watcher : NFObject {
    @public (weak) id _target;
}
    - (instancetype)initWithTarget:(id)t;
    @property (weak) id target;
@end