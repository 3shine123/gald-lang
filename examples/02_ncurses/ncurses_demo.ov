#include <stdio.h>
#include <string.h>
#include <ncurses.h>
#import <Foundation/Foundation.ov>
#import <Terminal/Ncurses.h>
#import <Terminal/Ncurses.ov>

int main() {
    @autoreleasepool {
        Terminal::Ncurses::Screen *scr = [Terminal::Ncurses::Screen screen];
        Terminal::Ncurses::Window *win = [[Terminal::Ncurses::Window alloc]
            initWithRect:2 y:2 w:[scr cols]-4 h:[scr rows]-4];

        [win drawBox];
        [win print:1 x:2 text:@"Ovic + Ncurses Demo"];

        Terminal::Ncurses::Button *b1 = [[Terminal::Ncurses::Button alloc]
            initWithWindow:win x:4 y:4 w:20 text:@"Quit"];
        Terminal::Ncurses::Button *b2 = [[Terminal::Ncurses::Button alloc]
            initWithWindow:win x:4 y:6 w:20 text:@"Click me"];

        Terminal::Ncurses::Label *lbl = [[Terminal::Ncurses::Label alloc]
            initWithWindow:win x:4 y:8 text:@"Press Tab to switch, Enter to select"];
        Terminal::Ncurses::TextBox *tb = [[Terminal::Ncurses::TextBox alloc]
            initWithWindow:win x:4 y:10 w:30];

        int sel = 0;
        int running = 1;

        while (running) {
            [win drawBox];
[win print:1 x:2 text:@"Ovic + Ncurses Demo"];
            [lbl draw];

            [b1 setHighlight:(sel == 0)];
            [b2 setHighlight:(sel == 1)];

            [b1 draw];
            [b2 draw];

            [win update];

            int ch = [scr readChar];
            switch (ch) {
                case '\t': case KEY_DOWN: sel = (sel + 1) % 2; break;
                case KEY_UP: sel = (sel + 1) % 2; break;
                case '\n': case KEY_ENTER:
                    if (sel == 0) { running = 0; }
                    else if (sel == 1) {
                        const char *input = [tb edit];
                        [lbl setText:[NPString stringWithUTF8String:input]];
                    }
                    break;
                case KEY_MOUSE:
                    if ([scr mouseEvent]) {
                        int mx = [scr mouseX];
                        int my = [scr mouseY];
                        if (my == 6 && mx >= 6 && mx < 26) { running = 0; }
                        if (my == 8 && mx >= 6 && mx < 26) {
                            const char *input = [tb edit];
                            [lbl setText:[NPString stringWithUTF8String:input]];
                        }
                    }
                    break;
            }
        }

        [tb release]; [lbl release];
        [b2 release]; [b1 release];
        [win release]; [scr release];
    }
    return 0;
}