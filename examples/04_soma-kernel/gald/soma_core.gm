// soma_core.gm — Soma Kernel 的 Gald 内核模块
// 演示高级特性（不依赖 Foundation / 无闭包，可自由裸机）：
//   - @namespace         命名空间：类名/符号自动带上 SomaCore__ 前缀
//   - @interface          类定义：隐式根类（不继承 NFObject），裸机可运行
//   - 类方法 / 实例方法   消息派发：类方法直接函数调用，实例方法走 isa->vtable
// 转译后: galdc -rewrite-gald 输出 C，clang -target i386-none-elf 编译进内核

extern void kputs(const char* s);
extern void kputdec(int v);
extern void kputhex(unsigned v);
extern void kputc(char c);
extern int kgetchar(void);
extern unsigned ktick(void);
extern void kcur_move(int dx);

// ================= 顶层纯函数（C 可直接调用，符号名不变） =================

void soma_io_wait(void) {
    asm volatile("outb %b0, $0x80" : : "a"((unsigned char)0));
}

int soma_gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int soma_fib(int n) {
    if (n <= 1) return n;
    return soma_fib(n - 1) + soma_fib(n - 2);
}

unsigned soma_xorshift(unsigned state) {
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return state;
}

unsigned soma_fnv1a(const char* s) {
    unsigned h = 2166136261;
    while (*s) {
        h ^= (unsigned char)*s;
        h *= 16777619;
        s++;
    }
    return h;
}

unsigned soma_rotl(unsigned x, unsigned n) {
    unsigned r = x;
    unsigned c = n;
    asm volatile("roll %b[c], %[r]" : [r] "+r"(r) : [c] "c"(c));
    return r;
}

// ================= @namespace + @interface（隐式根类） =================

@namespace SomaCore

    @interface Calculator {
        int total;
    }
    + (int) compute:(int)x;
    - (int) add:(int)x;
    - (int) value;
    @end

    @implementation Calculator

    + (int) compute:(int)x {
        return x * 2 + 1;
    }

    - (int) add:(int)x {
        total += x;
        return total;
    }

    - (int) value {
        return total;
    }

    @end

    @interface NFIoError {
        int code;
    }
    - (int) errorCode;
    @end

    @implementation NFIoError

    - (int) errorCode {
        return code;
    }

    @end

    // alloc+init via bump allocator (gald_alloc from runtime_freestanding.c)
    @interface HeapCounter {
        int total;
    }
    + (id) alloc;
    - (id) init;
    - (int) add:(int)x;
    - (int) value;
    @end

    @implementation HeapCounter

    + (id) alloc {
        return gald_alloc(self);
    }

    - (id) init {
        return self;
    }

    - (int) add:(int)x {
        total += x;
        return total;
    }

    - (int) value {
        return total;
    }

    @end
@endnamespace

// @protocol + @property + @synthesize + @public + instancetype
@protocol IProcess
- (int) run;
@end

@namespace SomaCore

    @interface SchedulerTask <IProcess> {
        @public
        int id;
    }
    @property int priority;
    + (instancetype) new;
    - (instancetype) init;
    - (int) getId;
    - (void) setId:(int)value;
    - (int) run;
    @end

    @implementation SchedulerTask
    @synthesize priority;
    + (instancetype) new  { return gald_alloc(self); }
    - (instancetype) init { return self; }
    - (int) getId { return id; }
    - (void) setId:(int)value { id = value; }
    - (int) run {
        kputs("       task id=");
        kputdec(id);
        kputs(" priority=");
        kputdec(_priority);
        kputs(" running\n");
        return id;
    }
    @end
@endnamespace

// ================= C 可见入口 =================

void soma_class_demo(void) {
    kputs("[gald] class method [SomaCore::Calculator compute:21] = ");
    kputdec([SomaCore::Calculator compute:21]);
    kputs("\n");
}

void soma_instance_demo(SomaCore::Calculator *acc) {
    kputs("[gald] instance methods on C-created obj: add:7 -> ");
    kputdec([acc add:7]);
    kputs(", add:35 -> ");
    kputdec([acc add:35]);
    kputs(", value = ");
    kputdec([acc value]);
    kputs("\n");
}

void soma_exc_demo(id err) {
    // @try/@catch/@finally — setjmp/longjmp based, no libc needed
    kputs("[gald] @try/@catch demo:\n");
    @try {
        kputs("       try body, throwing...\n");
        @throw err;
        kputs("       unreachable\n");
    } @catch(id e) {
        kputs("       caught [e errorCode] = ");
        kputdec([e errorCode]);
        kputs("\n");
    } @finally {
        kputs("       finally always runs\n");
    }
    kputs("       after-try continues\n");
}

void soma_heap_demo(void) {
    SomaCore::HeapCounter *c = [[SomaCore::HeapCounter alloc] init];
    kputs("[gald] alloc+init (bump allocator):\n");
    kputs("       [c add:10]=");
    kputdec([c add:10]);
    kputs(" [c add:20]=");
    kputdec([c add:20]);
    kputs(" [c value]=");
    kputdec([c value]);
    kputs("\n");
}

void soma_advanced_demo(void) {
    kputs("[gald] @protocol + @property + @synthesize + @public:\n");
    SomaCore::SchedulerTask *t;
    t = [SomaCore::SchedulerTask new];
    [t setId:7];              /* @public ivar via setter */
    [t setPriority:3];        /* @property setter */
    kputs("       priority = ");
    kputdec([t priority]);    /* @property getter */
    kputs(", id = ");
    kputdec([t getId]);          /* explicit getter */
    kputs("\n");
    [t run];                  /* protocol method */
}

void soma_kbd_demo(void) {
    kputs("[gald] keyboard demo: type, use <- -> to move cursor, Enter to finish\n");
    kputs("       (times out after ~6s in headless mode)\n");
    char line[40];
    int i = 0;    /* number of chars */
    int pos = 0;  /* cursor position in buffer */
    unsigned last = ktick();
    while (i < 39) {
        int c = kgetchar();
        if (c >= 0) {
            last = ktick();
            if (c == '\n') {
                line[i] = 0;
                kputs("\n");
                break;
            }
            if (c == 0x80) {                      /* left arrow */
                if (pos > 0) { pos--; kcur_move(-1); }
                continue;
            }
            if (c == 0x81) {                      /* right arrow */
                if (pos < i) { kcur_move(1); pos++; }
                continue;
            }
            if (c == 0x82 || c == 0x83) continue; /* up/down: ignore */
            if (c == '\b') {                       /* backspace */
                if (pos > 0) {
                    int j;
                    for (j = pos - 1; j < i - 1; j++) line[j] = line[j + 1];
                    i--;
                    pos--;
                    kcur_move(-1);                 /* back to deletion point */
                    for (j = pos; j < i; j++) kputc(line[j]);
                    kputc(' ');                    /* erase tail */
                    for (j = i; j >= pos; j--) kcur_move(-1);  /* cursor back to pos */
                }
                continue;
            }
            /* insert printable char at cursor (insert mode) */
            {
                int j;
                for (j = i; j > pos; j--) line[j] = line[j - 1];
                line[pos] = (char)c;
                i++;
                pos++;
                for (j = pos - 1; j < i; j++) kputc(line[j]);
                for (j = i; j > pos; j--) kcur_move(-1);
            }
        } else if (ktick() - last > 600) {
            kputs("\n       [timeout] no keyboard input\n");
            line[i] = 0;
            return;
        }
    }
    line[i] = 0;
    kputs("       you typed: '");
    kputs(line);
    kputs("'\n");
}

void soma_core_boot(void) {
    kputs("[gald] soma_core_boot()\n");
    kputs("       fib(10)=");
    kputdec(soma_fib(10));
    kputs("\n       gcd(1071,462)=");
    kputdec(soma_gcd(1071, 462));
    kputs("\n       fnv1a(\"soma-kernel\")=0x");
    kputhex(soma_fnv1a("soma-kernel"));
    kputs("\n       rotl(12345678,8)=0x");
    kputhex(soma_rotl(0x12345678, 8));
    kputs("\n       xorshift:");
    unsigned s = 0x12345678;
    for (int i = 0; i < 5; i++) {
        s = soma_xorshift(s);
        kputs(" ");
        kputhex(s);
    }
    kputs("\n");
}
