// Foundation —— 纯声明头（declaration-only）。
//
// 与 `Foundation.gh` 的区别只有一点：这里**不** `#import "*.gm"`。
// `Foundation.gh` 会把 9 个实现文件内联进每个使用者，于是每个 TU 都重复生成
// 整套 Foundation 定义（这正是满屏 `__attribute__((weak))` 的来源）。
//
// 用这个头 + 预编译好的 `libgaldfoundation.a`，你的 TU 里只会生成**你自己的**
// 代码；Foundation 的实现只存在库里一次 —— 也就是 Objective-C 的模型。
// 生成方式见 tools/make-decl-headers.sh，库的构建见 tools/build-foundation-lib.sh。
//
//     #import <Foundation/Foundation.decl.gh>      // 声明
//     galdc app.gm -I include -L <libdir> -lgaldfoundation -o app
#include <stdint.h>
#include <stddef.h>

#include "gald/runtime.h"

#import "NFObject.gh"
#import "NFString.gh"
#import "NFMutableString.gh"
#import "NFArray.gh"
#import "NFMutableArray.gh"
#import "NFDictionary.gh"
#import "NFMutableDictionary.gh"
#import "NFNumber.gh"
#import "NFError.gh"
