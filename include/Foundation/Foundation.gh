// Foundation —— 纯声明伞头（declaration-only）。
//
// 按项目约定（`.gh` = 声明，`.gm` = 实现），导入本头**不会**内联任何
// Foundation 实现：你的 TU 只生成你自己的代码，Foundation 的实现只在
// 预编译库里存一份 —— 也就是 Objective-C 的模型。
//
//     #import <Foundation/Foundation.gh>            // 纯声明
//     galdc app.gm -I include -L <libdir> -lgaldfoundation -o app
//
// 自包含单 TU 构建（实现内联进每个使用者，无需库）导入实现伞头：
//
//     #import <Foundation/Foundation.gm>
//
// 库的构建见 tools/build-foundation-lib.sh。
#include <stdint.h>
#include <stddef.h>

#include "gald/runtime.h"

#import "NFObject.gh"
#import "NFString.gh"
#import "NFMutableString.gh"
#import "NFArray.gh"
#import "NFMutableArray.gh"
#import "NFDictionary.gh"
#import "NFMutableDictionary.gh"
#import "NFNumber.gh"
#import "NFError.gh"
