// Foundation —— 自包含实现伞头（self-contained umbrella）。
//
// 同时导入全部 Foundation 类的声明与实现，单 TU 构建无需任何库：
//
//     #import <Foundation/Foundation.gm>
//
// 按 `.gh`/`.gm` 约定，纯声明伞头是 `Foundation.gh` —— 配合预编译库
// （tools/build-foundation-lib.sh）使用，让 Foundation 的实现只存一份。
#include <stdint.h>
#include <stddef.h>

#include "gald/runtime.h"

#import "NFObject.gh"
#import "NFObject.gm"
#import "NFString.gh"
#import "NFString.gm"
#import "NFMutableString.gh"
#import "NFMutableString.gm"
#import "NFArray.gh"
#import "NFArray.gm"
#import "NFMutableArray.gh"
#import "NFMutableArray.gm"
#import "NFDictionary.gh"
#import "NFDictionary.gm"
#import "NFMutableDictionary.gh"
#import "NFMutableDictionary.gm"
#import "NFNumber.gh"
#import "NFNumber.gm"
#import "NFError.gh"
#import "NFError.gm"
