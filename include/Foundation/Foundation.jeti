// Foundation —— 自包含实现伞头（self-contained umbrella）。
//
// 同时导入全部 Foundation 类的声明与实现，单 TU 构建无需任何库：
//
//     #import <Foundation/Foundation.jeti>
//
// 按 `.jth`/`.jeti` 约定，纯声明伞头是 `Foundation.jth` —— 配合预编译库
// （tools/build-foundation-lib.sh）使用，让 Foundation 的实现只存一份。
#include <stdint.h>
#include <stddef.h>

#include "jeti/runtime.h"

