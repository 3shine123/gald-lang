#ifndef NFARRAY_NH
#define NFARRAY_NH

#import <Foundation/NFObject.nh>

// Generic since the modernization pass: `NFArray<T>` specializes via
// monomorphization (objectAtIndex: returns T, addObject-style params take T).
// The BARE spelling `NFArray` (no type args) keeps its pre-existing erased
// behavior and symbols — existing code needs zero migration.
@interface NFArray<T> : NFObject {
@public
    NFObject **_items;
    size_t _count;
    size_t _capacity;
}

+ (id)arrayWithObjects:(id *)objs count:(size_t)n;
+ (id)arrayWithObject:(T)obj;
+ (id)array;

- (size_t)count;
- (T)objectAtIndex:(size_t)index;
- (T)firstObject;
- (T)lastObject;
- (BOOL)containsObject:(T)obj;
- (size_t)indexOfObject:(T)obj;
- (id)copy;
- (NFString *)description;

@end

#endif