#ifndef NFERROR_NH
#define NFERROR_NH

#import <Foundation/NFObject.nh>
#import <Foundation/NFString.nh>
#import <Foundation/NFDictionary.nh>

// Error domains, matching ObjC's convention of reversing-DNS prefixes.
#define NFErrorDomain            @"NFErrorDomain"
#define NFErrorFileIO            @"NFErrorFileIO"
#define NFErrorParse             @"NFErrorParse"

// The out-parameter shape used throughout Foundation for fallible methods:
//   - (BOOL)write:(NFString *)text error:(NFError **)outError;
// The callee allocates the error only when it returns NO, so the caller's
// read of `*outError` is guarded by the return value, not by nil-checking.
// Nullability annotates the INNER pointer (the error is nullable); the outer
// pointer is always nonnull because the callee writes through it.
@interface NFError : NFObject {
@public
    int         _code;
    NFString   *_domain;
    NFDictionary *_userInfo;
}

// Designated-ish constructors. `+errorWithCode:domain:` is the common case;
// userInfo is optional context (keys are strings, values are objects).
+ (NFError *)errorWithCode:(int)code domain:(NFString *)domain;
+ (NFError *)errorWithCode:(int)code domain:(NFString *)domain
                  userInfo:(nullable NFDictionary *)userInfo;
- (NFError *)initWithCode:(int)code domain:(NFString *)domain
                 userInfo:(nullable NFDictionary *)userInfo;

// A ready-made parse error — the shape every parser-ish method wants.
+ (NFError *)parseErrorWithMessage:(NFString *)message;
+ (NFError *)fileIOErrorWithMessage:(NFString *)message;

- (int)code;
- (NFString *)domain;
- (nullable NFDictionary *)userInfo;

@property (nonatomic, readonly, nonnull) NFString *localizedDescription;

@end

#endif
