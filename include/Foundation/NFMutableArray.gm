#import <Foundation/NFMutableArray.gh>
#import <Foundation/NFArray.gm>
#include <string.h>
#include <stdlib.h>

@implementation NFMutableArray

- (NFMutableArray *)initWithCapacity:(size_t)capacity {
    self = [super init];
    if (self) {
        _items = NULL;
        _count = 0;
        _capacity = 0;
        if (capacity > 0) {
            NFObject **items = (NFObject **)malloc(capacity * sizeof(NFObject *));
            if (items) {
                _items = items;
                _capacity = capacity;
            }
        }
    }
    return self;
}

- (NFMutableArray *)init {
    return [self initWithCapacity:0];
}

- (NFMutableArray *)initWithArray:(NFArray *)other {
    self = [self init];
    if (self && other) {
        size_t n = [other count];
        for (size_t i = 0; i < n; i++) {
            [self addObject:[other objectAtIndex:i]];
        }
    }
    return self;
}

- (NFMutableArray *)initWithObjects:(id *)objs count:(size_t)n {
    self = [self init];
    if (self && n > 0 && objs) {
        for (size_t i = 0; i < n; i++) {
            [self addObject:objs[i]];
        }
    }
    return self;
}

+ (NFMutableArray *)arrayWithCapacity:(size_t)capacity {
    @noarc {
        return [[[self alloc] initWithCapacity:capacity] autorelease];
    }
}

+ (NFMutableArray *)array {
    @noarc {
        return [[[self alloc] init] autorelease];
    }
}

+ (NFMutableArray *)arrayWithObject:(T)obj {
    @noarc {
        NFMutableArray *arr = [self arrayWithCapacity:1];
        if (arr && obj) {
            [arr addObject:obj];
        }
        return arr;
    }
}

+ (NFMutableArray *)arrayWithObjects:(id *)objs count:(size_t)n {
    @noarc {
        NFMutableArray *arr = [self arrayWithCapacity:n];
        if (arr) {
            for (size_t i = 0; i < n; i++) {
                if (objs[i]) {
                    [arr addObject:objs[i]];
                }
            }
        }
        return arr;
    }
}

- (void)addObject:(T)obj {
    if (!obj) return;
    if (_count >= _capacity) {
        size_t newcap = _capacity == 0 ? 4 : _capacity * 2;
        NFObject **items = (NFObject **)realloc(_items, newcap * sizeof(NFObject *));
        if (!items) return;
        _items = items;
        _capacity = newcap;
    }
    _items[_count] = gald_retain(obj);
    _count++;
}

- (void)addObjectsFromArray:(NFArray *)other {
    if (!other) return;
    size_t n = [other count];
    for (size_t i = 0; i < n; i++) {
        [self addObject:[other objectAtIndex:i]];
    }
}

- (void)insertObject:(T)obj atIndex:(size_t)index {
    if (!obj) return;
    if (index > _count) index = _count;
    if (_count >= _capacity) {
        size_t newcap = _capacity == 0 ? 4 : _capacity * 2;
        NFObject **items = (NFObject **)realloc(_items, newcap * sizeof(NFObject *));
        if (!items) return;
        _items = items;
        _capacity = newcap;
    }
    memmove(_items + index + 1, _items + index, (_count - index) * sizeof(NFObject *));
    _items[index] = gald_retain(obj);
    _count++;
}

- (void)removeObjectAtIndex:(size_t)index {
    if (index >= _count) return;
    NFObject *removed = _items[index];
    memmove(_items + index, _items + index + 1, (_count - index - 1) * sizeof(NFObject *));
    _count--;
    if (removed) {
        gald_release(removed);
    }
}

- (void)removeLastObject {
    if (_count == 0) return;
    [self removeObjectAtIndex:_count - 1];
}

- (void)removeObject:(T)obj {
    if (!obj) return;
    for (size_t i = 0; i < _count; i++) {
        if (_items[i] == obj) {
            [self removeObjectAtIndex:i];
            return;
        }
    }
}

- (void)removeAllObjects {
    for (size_t i = 0; i < _count; i++) {
        if (_items[i]) {
            gald_release(_items[i]);
        }
    }
    _count = 0;
}

- (void)replaceObjectAtIndex:(size_t)index withObject:(T)obj {
    if (!obj || index >= _count) return;
    NFObject *old = _items[index];
    _items[index] = gald_retain(obj);
    if (old) {
        gald_release(old);
    }
}

- (void)exchangeObjectAtIndex:(size_t)a withObjectAtIndex:(size_t)b {
    if (a >= _count || b >= _count) return;
    NFObject *tmp = _items[a];
    _items[a] = _items[b];
    _items[b] = tmp;
}

- (void)setObject:(T)obj atIndex:(size_t)index {
    if (!obj || index >= _count) return;
    [self replaceObjectAtIndex:index withObject:obj];
}

@end
