#ifndef NFMUTABLEARRAY_NH
#define NFMUTABLEARRAY_NH

#import <Foundation/NFArray.nh>

// Mutable counterpart of NFArray. Inherits NFArray's storage ivars
// (_items / _count / _capacity) and the immutable querying API
// (count / objectAtIndex: / firstObject / lastObject / containsObject: / ...).
// Generic since the modernization pass: `NFMutableArray<T> : NFArray<T>` —
// addObject:/insertObject: take T in the specialization. Bare `NFMutableArray`
// keeps its erased behavior (zero migration for existing code).
@interface NFMutableArray<T> : NFArray<T> {
@public
    // ivars inherited from NFArray
}

+ (NFMutableArray *)arrayWithCapacity:(size_t)capacity;
+ (NFMutableArray *)array;
+ (NFMutableArray *)arrayWithObject:(T)obj;
+ (NFMutableArray *)arrayWithObjects:(id *)objs count:(size_t)n;

- (NFMutableArray *)init;
- (NFMutableArray *)initWithCapacity:(size_t)capacity;
- (NFMutableArray *)initWithArray:(NFArray *)other;
- (NFMutableArray *)initWithObjects:(id *)objs count:(size_t)n;

- (void)addObject:(T)obj;
- (void)addObjectsFromArray:(NFArray *)other;
- (void)insertObject:(T)obj atIndex:(size_t)index;
- (void)removeObjectAtIndex:(size_t)index;
- (void)removeLastObject;
- (void)removeObject:(T)obj;
- (void)removeAllObjects;
- (void)replaceObjectAtIndex:(size_t)index withObject:(T)obj;
- (void)exchangeObjectAtIndex:(size_t)a withObjectAtIndex:(size_t)b;
- (void)setObject:(T)obj atIndex:(size_t)index;

@end

#endif
