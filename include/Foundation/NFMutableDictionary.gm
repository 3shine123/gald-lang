#import <Foundation/NFMutableDictionary.gh>
#import <Foundation/NFDictionary.gm>
#include <string.h>
#include <stdlib.h>

@implementation NFMutableDictionary

- (NFMutableDictionary *)initWithCapacity:(size_t)capacity {
    self = [super init];
    if (self) {
        _keys = NULL;
        _values = NULL;
        _count = 0;
        _capacity = 0;
        if (capacity > 0) {
            NFObject **ks = (NFObject **)calloc(capacity, sizeof(NFObject *));
            NFObject **vs = (NFObject **)calloc(capacity, sizeof(NFObject *));
            if (ks && vs) {
                _keys = ks;
                _values = vs;
                _capacity = capacity;
            } else {
                free(ks);
                free(vs);
            }
        }
    }
    return self;
}

- (NFMutableDictionary *)init {
    return [self initWithCapacity:0];
}

- (NFMutableDictionary *)initWithDictionary:(NFDictionary *)other {
    self = [self init];
    if (self && other) {
        [self addEntriesFromDictionary:other];
    }
    return self;
}

+ (NFMutableDictionary *)dictionaryWithCapacity:(size_t)capacity {
    @noarc {
        return [[[self alloc] initWithCapacity:capacity] autorelease];
    }
}

+ (NFMutableDictionary *)dictionary {
    @noarc {
        return [[[self alloc] init] autorelease];
    }
}

+ (NFMutableDictionary *)dictionaryWithObject:(V)value forKey:(K)key {
    @noarc {
        NFMutableDictionary *dict = [self dictionaryWithCapacity:1];
        if (dict && key && value) {
            [dict setObject:value forKey:key];
        }
        return dict;
    }
}

// An equal key (isEqual:) is replaced in place, never appended, so the
// dictionary can never hold two keys that compare equal.
- (void)setObject:(V)value forKey:(K)key {
    if (!key || !value) return;
    for (size_t i = 0; i < _count; i++) {
        if (_keys[i] && [_keys[i] isEqual:key]) {
            if (_values[i] != value) {
                NFObject *old = _values[i];
                _values[i] = gald_retain(value);
                if (old) {
                    gald_release(old);
                }
            }
            return;
        }
    }
    if (_count >= _capacity) {
        size_t newcap = _capacity == 0 ? 4 : _capacity * 2;
        NFObject **ks = (NFObject **)realloc(_keys, newcap * sizeof(NFObject *));
        if (!ks) return;
        _keys = ks;
        NFObject **vs = (NFObject **)realloc(_values, newcap * sizeof(NFObject *));
        if (!vs) return;
        _values = vs;
        _capacity = newcap;
    }
    _keys[_count] = gald_retain(key);
    _values[_count] = gald_retain(value);
    _count++;
}

- (void)addEntriesFromDictionary:(NFDictionary *)other {
    if (!other) return;
    NFArray *ks = [other allKeys];
    size_t n = [ks count];
    for (size_t i = 0; i < n; i++) {
        id k = [ks objectAtIndex:i];
        [self setObject:[other objectForKey:k] forKey:k];
    }
}

- (void)removeObjectForKey:(K)key {
    if (!key) return;
    for (size_t i = 0; i < _count; i++) {
        if (_keys[i] && [_keys[i] isEqual:key]) {
            NFObject *k = _keys[i];
            NFObject *v = _values[i];
            memmove(_keys + i, _keys + i + 1, (_count - i - 1) * sizeof(NFObject *));
            memmove(_values + i, _values + i + 1, (_count - i - 1) * sizeof(NFObject *));
            _count--;
            if (k) {
                gald_release(k);
            }
            if (v) {
                gald_release(v);
            }
            return;
        }
    }
}

- (void)removeAllObjects {
    for (size_t i = 0; i < _count; i++) {
        if (_keys[i]) {
            gald_release(_keys[i]);
        }
        if (_values[i]) {
            gald_release(_values[i]);
        }
    }
    _count = 0;
}

@end
