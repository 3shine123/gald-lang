#ifndef NFMUTABLESTRING_NH
#define NFMUTABLESTRING_NH

#import <Foundation/NFString.nh>

@interface NFMutableString : NFString {
@public
    // inherits NFString ivars: _cstr, _length, _hash, _hashIsValid
}

+ (NFMutableString *)stringWithUTF8String:(const char *)cstr;
+ (NFMutableString *)stringWithString:(NFString *)str;

- (NFMutableString *)initWithUTF8String:(const char *)cstr;
- (NFMutableString *)initWithString:(NFString *)str;

- (void)appendString:(NFString *)str;
- (void)appendUTF8String:(const char *)cstr;
- (void)insertString:(NFString *)str atIndex:(size_t)idx;
- (void)deleteCharactersInRange:(NFRange)range;
- (void)replaceCharactersInRange:(NFRange)range withString:(NFString *)str;
- (void)setString:(NFString *)str;

@end

#endif