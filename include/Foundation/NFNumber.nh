#ifndef NFNUMBER_NH
#define NFNUMBER_NH

#import <Foundation/NFObject.nh>
#import <Foundation/NFString.nh>

@interface NFNumber : NFObject {
@public
    int         _isDouble;
    long long   _intValue;
    double      _doubleValue;
}

+ (NFNumber *)numberWithInt:(int)value;
+ (NFNumber *)numberWithLongLong:(long long)value;
+ (NFNumber *)numberWithDouble:(double)value;
+ (NFNumber *)numberWithBool:(int)value;
+ (NFNumber *)numberWithChar:(char)value;

- (NFNumber *)initWithLongLong:(long long)value;
- (NFNumber *)initWithDouble:(double)value;

- (int)intValue;
- (long long)longLongValue;
- (double)doubleValue;
- (int)boolValue;
- (char)charValue;

- (NFString *)description;
// Value equality, as in ObjC's NSNumber: `isEqual:` against another NFNumber
// compares numeric values, so `@1` equals a distinct `@(i + 1)` that also
// holds 1. Needed for value-semantics dictionary keys.
- (BOOL)isEqual:(id)object;
- (int)isEqualToNumber:(NFNumber *)other;

@end

#endif
