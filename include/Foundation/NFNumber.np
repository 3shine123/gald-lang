#import <Foundation/NFNumber.nh>
#import <Foundation/NFObject.np>
#include <stdio.h>

@implementation NFNumber

- (NFNumber *)initWithLongLong:(long long)value {
    self = [super init];
    if (self) {
        _isDouble = 0;
        _intValue = value;
        _doubleValue = (double)value;
    }
    return self;
}

- (NFNumber *)initWithDouble:(double)value {
    self = [super init];
    if (self) {
        _isDouble = 1;
        _doubleValue = value;
        _intValue = (long long)value;
    }
    return self;
}

+ (NFNumber *)numberWithInt:(int)value {
    @noarc {
        return [[[self alloc] initWithLongLong:(long long)value] autorelease];
    }
}

+ (NFNumber *)numberWithLongLong:(long long)value {
    @noarc {
        return [[[self alloc] initWithLongLong:value] autorelease];
    }
}

+ (NFNumber *)numberWithDouble:(double)value {
    @noarc {
        return [[[self alloc] initWithDouble:value] autorelease];
    }
}

+ (NFNumber *)numberWithBool:(int)value {
    @noarc {
        return [[[self alloc] initWithLongLong:(long long)(value ? 1 : 0)] autorelease];
    }
}

+ (NFNumber *)numberWithChar:(char)value {
    @noarc {
        return [[[self alloc] initWithLongLong:(long long)value] autorelease];
    }
}

- (int)intValue { return (int)_intValue; }
- (long long)longLongValue { return _intValue; }
- (double)doubleValue { return _isDouble ? _doubleValue : (double)_intValue; }
- (int)boolValue { return _isDouble ? (_doubleValue != 0.0) : (_intValue != 0); }
- (char)charValue { return (char)_intValue; }

- (NFString *)description {
    char buf[64];
    if (_isDouble) {
        snprintf(buf, sizeof(buf), "%g", _doubleValue);
    } else {
        snprintf(buf, sizeof(buf), "%lld", _intValue);
    }
    return [NFString stringWithUTF8String:buf];
}

- (BOOL)isEqual:(id)object {
    if (self == (NFObject *)object) return YES;
    if (!object) return NO;
    if ([object isKindOfClass:[NFNumber class]]) {
        return [self isEqualToNumber:(NFNumber *)object];
    }
    return [super isEqual:object];
}

- (int)isEqualToNumber:(NFNumber *)other {
    if (!other) return 0;
    return [self doubleValue] == [other doubleValue];
}

@end
