#import "NFObject.gh"

@implementation gald_root
- (id)init {
    return gald_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    gald_release(self);
}
- (id)retain {
    return gald_retain(self);
}
- (BOOL)isKindOf:(Class)cls {
    return gald_isKindOf(self, cls);
}
- (BOOL)isKindOfClass:(Class)cls {
    return gald_isKindOfClass(self, cls);
}
- (BOOL)isEqual:(id)object {
    /* Default: identity (pointer equality), matching NSObject. */
    return self == object;
}
- (id)description {
    return nil;
}
@end

@implementation NFObject
+ (id)alloc {
    return gald_alloc(self);
}
+ (id)new {
    id obj = gald_alloc(self);
    return gald_init(obj);
}
- (id)init {
    return gald_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    gald_release(self);
}
- (id)retain {
    return gald_retain(self);
}
- (id)description {
    return nil;
}
@end