#ifndef NFSTRING_NH
#define NFSTRING_NH

#import <Foundation/NFObject.nh>

typedef struct {
    size_t location;
    size_t length;
} NFRange;

#ifndef YES
#define YES 1
#endif
#ifndef NO
#define NO 0
#endif

@interface NFString : NFObject {
@public
    char        *_cstr;
    size_t      _length;
    uint32_t    _hash;
    int         _hashIsValid;
}

+ (NFString *)stringWithUTF8String:(const char *)cstr;
+ (NFString *)stringWithString:(NFString *)str;

- (NFString *)initWithUTF8String:(const char *)cstr;
- (NFString *)initWithString:(NFString *)str;

- (size_t)length;
- (const char *)UTF8String;
- (char)characterAtIndex:(size_t)index;

// Content equality, as in ObjC's NSString: `isEqual:` against another
// NFString compares characters, so an equal-but-distinct object (a fresh
// `@"key"` literal, a dictionary key looked up again) compares equal.
// Non-string operands fall back to NSObject's identity comparison.
- (BOOL)isEqual:(id)object;
- (int)isEqualToString:(NFString *)other;
- (int)compare:(NFString *)other;
- (int)hasPrefix:(NFString *)prefix;
- (int)hasSuffix:(NFString *)suffix;

- (NFRange)rangeOfString:(NFString *)substring;

- (NFString *)substringFromIndex:(size_t)from;
- (NFString *)substringToIndex:(size_t)to;
- (NFString *)substringWithRange:(NFRange)range;

- (NFString *)stringByAppendingString:(NFString *)other;
- (NFString *)stringByAppendingUTF8String:(const char *)cstr;

- (NFString *)uppercaseString;
- (NFString *)lowercaseString;

- (uint32_t)hash;
- (NFString *)description;
- (NFString *)copy;

@end

#endif