#import "NPObject.nh"

@implementation nupa_root
- (id)init {
    return nupa_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    nupa_release(self);
}
- (id)retain {
    return nupa_retain(self);
}
- (BOOL)isKindOf:(Class)cls {
    return nupa_isKindOf(self, cls);
}
- (BOOL)isKindOfClass:(Class)cls {
    return nupa_isKindOfClass(self, cls);
}
- (BOOL)isEqual:(id)object {
    /* Default: identity (pointer equality), matching NSObject. */
    return self == object;
}
- (id)description {
    return nil;
}
@end

@implementation NPObject
+ (id)alloc {
    return nupa_alloc(self);
}
+ (id)new {
    id obj = nupa_alloc(self);
    return nupa_init(obj);
}
- (id)init {
    return nupa_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    nupa_release(self);
}
- (id)retain {
    return nupa_retain(self);
}
- (id)description {
    return nil;
}
@end