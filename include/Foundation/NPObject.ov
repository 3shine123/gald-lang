#import "NPObject.oh"

@implementation ovic_root
- (id)init {
    return ovic_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    ovic_release(self);
}
- (id)retain {
    return ovic_retain(self);
}
- (BOOL)isKindOf:(Class)cls {
    return ovic_isKindOf(self, cls);
}
- (BOOL)isKindOfClass:(Class)cls {
    return ovic_isKindOfClass(self, cls);
}
- (BOOL)isEqual:(id)object {
    /* Default: identity (pointer equality), matching NSObject. */
    return self == object;
}
- (id)description {
    return nil;
}
@end

@implementation NPObject
+ (id)alloc {
    return ovic_alloc(self);
}
+ (id)new {
    id obj = ovic_alloc(self);
    return ovic_init(obj);
}
- (id)init {
    return ovic_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    ovic_release(self);
}
- (id)retain {
    return ovic_retain(self);
}
- (id)description {
    return nil;
}
@end