#import "NPObject.oh"

@implementation ovel_root
- (id)init {
    return ovel_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    ovel_release(self);
}
- (id)retain {
    return ovel_retain(self);
}
- (BOOL)isKindOf:(Class)cls {
    return ovel_isKindOf(self, cls);
}
- (BOOL)isKindOfClass:(Class)cls {
    return ovel_isKindOfClass(self, cls);
}
- (BOOL)isEqual:(id)object {
    /* Default: identity (pointer equality), matching NSObject. */
    return self == object;
}
- (id)description {
    return nil;
}
@end

@implementation NPObject
+ (id)alloc {
    return ovel_alloc(self);
}
+ (id)new {
    id obj = ovel_alloc(self);
    return ovel_init(obj);
}
- (id)init {
    return ovel_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    ovel_release(self);
}
- (id)retain {
    return ovel_retain(self);
}
- (id)description {
    return nil;
}
@end