#import "NPObject.nh"

@implementation nepa_root
- (id)init {
    return nepa_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    nepa_release(self);
}
- (id)retain {
    return nepa_retain(self);
}
- (BOOL)isKindOf:(Class)cls {
    return nepa_isKindOf(self, cls);
}
- (BOOL)isKindOfClass:(Class)cls {
    return nepa_isKindOfClass(self, cls);
}
- (BOOL)isEqual:(id)object {
    /* Default: identity (pointer equality), matching NSObject. */
    return self == object;
}
- (id)description {
    return nil;
}
@end

@implementation NPObject
+ (id)alloc {
    return nepa_alloc(self);
}
+ (id)new {
    id obj = nepa_alloc(self);
    return nepa_init(obj);
}
- (id)init {
    return nepa_init(self);
}
- (void)dealloc {
    return;
}
- (void)release {
    nepa_release(self);
}
- (id)retain {
    return nepa_retain(self);
}
- (id)description {
    return nil;
}
@end