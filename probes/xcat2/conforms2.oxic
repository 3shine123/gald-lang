#import <Foundation/Foundation.np>
@protocol Greetable
- (const char *)greet;
@end
@protocol Loud <Greetable>
- (void)shout;
@end
@interface Dog : NPObject <Loud>
@end
@implementation Dog
- (const char *)greet { return "woof"; }
- (void)shout { }
@end
int main(void) {
    printf("step1-alloc\n"); fflush(stdout);
    Dog *d = [[Dog alloc] init];
    printf("step2-call\n"); fflush(stdout);
    int r1 = [d conformsToProtocol:@protocol(Loud)];
    printf("step3-r1=%d\n", r1); fflush(stdout);
    int r2 = [d conformsToProtocol:@protocol(Greetable)];
    printf("step4-r2=%d\n", r2); fflush(stdout);
    return 0;
}
