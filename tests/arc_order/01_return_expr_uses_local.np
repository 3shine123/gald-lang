#import <Foundation/Foundation.np>

// ARC order 01: the return expression USES an owned local.
//
// Root cause shape: `return <Binary using h>;` — the old analyzer did not
// recognize a `Binary` top level as "using h", so it inserted
// `nopa_release(h)` BEFORE the return expression: use-after-free.
//
// `dealloc` clears `_s` so the failure is deterministic even if the freed
// memory happens to be untouched: a prematurely released holder makes
// `[h text]` yield nil, `[nil length]` 0, and main returns -5.

@interface AO01Holder : NFObject {
@public
    NFString *_s;
}
- (NFString *)text;
@end

@implementation AO01Holder
- (instancetype)init {
    self = [super init];
    if (self) { _s = [[NFString alloc] initWithUTF8String:"hello"]; }
    return self;
}
- (void)dealloc {
    _s = nil;
    NFLog(@"ao01 dealloc");
    [super dealloc];
}
- (NFString *)text { return _s; }
@end

int main() {
    AO01Holder *h = [[AO01Holder alloc] init];
    return [[h text] length] - 5;
}
