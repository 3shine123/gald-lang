#import <Foundation/Foundation.gh>

// ARC order 02: `return [w text];` — the local IS used by the exit expression
// and must still be released after it, but the old `extract_returned_var`
// treated "receiver is a bare VarRef" as ownership TRANSFER and skipped the
// release entirely: a leak (no dealloc), not a crash.
//
// The returned value is autoreleased, so releasing `w` afterwards is safe.
// Kept deliberately single-assertion: owning the dealloc of an *ivar* is a
// separate, still-open ARC gap (see tests/arc_order/README.md).

@interface AO02Wrap : NFObject
- (NFString *)text;
@end

@implementation AO02Wrap
- (void)dealloc {
    NFLog(@"ao02 wrap dealloc");
    [super dealloc];
}
- (NFString *)text { return [NFString stringWithUTF8String:"world"]; }
@end

NFString *ao02_fetch(void) {
    AO02Wrap *w = [[AO02Wrap alloc] init];
    return [w text];
}

int main() {
    NFString *s = ao02_fetch();
    NFLog(@"ao02 len=%d", (int)[s length]);
    return [s length] == 5 ? 0 : 1;
}
