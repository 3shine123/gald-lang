#import <Foundation/Foundation.gm>

// ARC order 06: `@throw <expr>` — the thrown expression must be fully
// evaluated before the enclosing locals are released. The old analyzer only
// recognized a bare VarRef / VarRef-receiver as "the exception expression
// uses this local", so a nested send (`[[h reason] description]`) let it
// release `h` first: use-after-free on the throwing path.

@interface AO06Holder : NFObject
- (NFString *)reason;
@end

@implementation AO06Holder
- (void)dealloc {
    NFLog(@"ao06 holder dealloc");
    [super dealloc];
}
- (NFString *)reason { return [NFString stringWithUTF8String:"bad"]; }
@end

void ao06_boom(void) @throws(NFString *) {
    AO06Holder *h = [[AO06Holder alloc] init];
    @throw [[h reason] description];
}

int main() {
    @try {
        ao06_boom();
    }
    @catch (NFString *e) {
        NFLog(@"ao06 caught: %@", e);
    }
    NFLog(@"ao06 done");
    return 0;
}
