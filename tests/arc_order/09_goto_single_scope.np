#import <Foundation/Foundation.np>

// ARC order 09: `goto` must release the owned locals of the scope it leaves.
// C labels are function-scoped, so jumping out of a nested block used to leak
// everything declared inside it.

@interface AO09Item : NFObject
@end

@implementation AO09Item
- (void)dealloc {
    NFLog(@"ao09 dealloc");
    [super dealloc];
}
@end

int main() {
    {
        AO09Item *x = [[AO09Item alloc] init];
        NFLog(@"ao09 in block");
        goto out;
    }
    NFLog(@"ao09 unreachable");

out:
    NFLog(@"ao09 done");
    return 0;
}
