#import <Foundation/Foundation.np>

// ARC order 15: a class WITH a user `dealloc` owns its ivar policy. ARC must
// NOT add a synthesized release on top of it — the body below already releases
// both ivars, so a second release would double-free.
//
// This is the shape `tests/space_dodge.np` uses (handwritten
// `NFObject_release(_obs)` in dealloc), which regressed when ARC synthesized
// ivar release for every class regardless.

@interface AO15Child : NFObject
@end

@implementation AO15Child
- (void)dealloc {
    NFLog(@"ao15 child dealloc");
    [super dealloc];
}
@end

@interface AO15Owner : NFObject {
@public
    AO15Child *_a;
    AO15Child *_b;
}
@end

@implementation AO15Owner
- (instancetype)init {
    self = [super init];
    if (self) {
        _a = [[AO15Child alloc] init];
        _b = [[AO15Child alloc] init];
    }
    return self;
}
- (void)dealloc {
    NFLog(@"ao15 owner dealloc");
    if (_a) NFObject_release(_a);
    if (_b) NFObject_release(_b);
    [super dealloc];
}
@end

int main() {
    AO15Owner *o = [[AO15Owner alloc] init];
    NFLog(@"ao15 done using");
    return 0;
}
