// C99 designated initializers — feature test.
// Forms covered:
//   1. full designated:        struct Point p1 = { .x = 1, .y = 2 };
//   2. partial (zero fill):    struct Point p2 = { .y = 5 };
//   3. mixed designated+pos:   struct Point p3 = { .x = 1, 7 };
//   4. compound literal:       NPRange r = (NPRange){ .location = 3, .length = 9 };
//   5. array element designated: CGPoint pts[3] = { [0].x = 1, [2].y = 6 };
//   6. nested member chains:   struct Outer o = { .in.a = 3, .tag = 9 };

#include <stdio.h>

struct Point { int x; int y; };

typedef struct {
    float wx;
    float wy;
} CGPoint;

typedef struct {
    size_t location;
    size_t length;
} NPRange;

struct Inner { int a; int b; };
struct Outer { struct Inner in; int tag; };

static void dump(const char *name, struct Point p) {
    printf("%s: x=%d y=%d\n", name, p.x, p.y);
}

int main() {
    // 1. full designated
    struct Point p1 = { .x = 1, .y = 2 };
    dump("p1", p1);

    // 2. partial — missing fields must be zero-filled
    struct Point p2 = { .y = 5 };
    dump("p2", p2);

    // 3. mixed designated + positional (C99): the positional 7 continues
    //    after the last initialized field, so it lands in .y
    struct Point p3 = { .x = 1, 7 };
    dump("p3", p3);

    // 4. compound literal with designators
    NPRange r = (NPRange){ .location = 3, .length = 9 };
    printf("r: loc=%zu len=%zu\n", r.location, r.length);

    // 5. array element designated initializers
    CGPoint pts[3] = { [0].wx = 1, [2].wy = 6 };
    printf("pts0: %.1f %.1f\n", pts[0].wx, pts[0].wy);
    printf("pts1: %.1f %.1f\n", pts[1].wx, pts[1].wy);
    printf("pts2: %.1f %.1f\n", pts[2].wx, pts[2].wy);

    // 6. nested member chains
    struct Outer o = { .in.a = 3, .tag = 9 };
    printf("o: in.a=%d in.b=%d tag=%d\n", o.in.a, o.in.b, o.tag);

    // chained designator on array element: [1].wx
    CGPoint g[2] = { [1].wx = 2.5f };
    printf("g1: %.1f %.1f\n", g[1].wx, g[1].wy);

    if (p1.x != 1 || p1.y != 2) { printf("FAIL form1\n"); return 1; }
    if (p2.x != 0 || p2.y != 5) { printf("FAIL form2\n"); return 1; }
    if (p3.x != 1 || p3.y != 7) { printf("FAIL form3\n"); return 1; }
    if (r.location != 3 || r.length != 9) { printf("FAIL form4\n"); return 1; }
    if (pts[0].wx != 1.0f || pts[2].wy != 6.0f || pts[1].wx != 0.0f) { printf("FAIL form5\n"); return 1; }
    if (o.in.a != 3 || o.in.b != 0 || o.tag != 9) { printf("FAIL form6\n"); return 1; }
    if (g[1].wx != 2.5f || g[1].wy != 0.0f || g[0].wx != 0.0f) { printf("FAIL form7\n"); return 1; }

    printf("designated init: ALL OK\n");
    return 0;
}
