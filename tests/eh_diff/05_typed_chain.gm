// 差分用例 5:typed catch 链 —— 类型不匹配的 catch 必须放行给外层
#import <Foundation/Foundation.gh>

@interface A : NFObject @end
@implementation A
@end

@interface B : NFObject @end
@implementation B
@end

int main() {
    @try {
        @try {
            @throw [[B alloc] init];
        }
        @catch (A *a) {
            NFLog(@"caught A (wrong)");
        }
    }
    @catch (B *b) {
        NFLog(@"caught B");
    }
    NFLog(@"end");
    return 0;
}
