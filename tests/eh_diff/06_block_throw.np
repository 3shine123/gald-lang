// 差分用例 6:block 字面量内 @throw —— checked 支持(block 体按独立函数降级,
// 旗标跨 invoke 边界保留,调用方守卫尾段接管)
#import <Foundation/Foundation.np>

typedef void (^ThrowerBlock)(void);

int main() {
    @try {
        ThrowerBlock b = ^{
            NFLog(@"in block");
            @throw @"from-block";
        };
        b();
    }
    @catch (NFString *e) {
        NFLog(@"caught from block");
    }
    NFLog(@"end");
    return 0;
}
