#import <Foundation/Foundation.gm>

// Scenario 4 of the EH acceptance matrix: @finally ordering.
//
// Required order (ObjC semantics, and what `-eh checked` was built to match):
//   inner try -> inner finally -> outer catch -> outer finally -> after
// A nested @try whose exception is NOT caught locally must run its own
// @finally before the exception reaches the enclosing @catch.

int main() {
    @try {
        @try {
            NFLog(@"inner-try");
            @throw @"err";
        }
        @finally {
            NFLog(@"inner-finally");
        }
    }
    @catch (NFString *e) {
        NFLog(@"outer-catch: %@", e);
    }
    @finally {
        NFLog(@"outer-finally");
    }
    NFLog(@"after");
    return 0;
}
