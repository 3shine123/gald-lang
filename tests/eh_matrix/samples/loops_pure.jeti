// Guard-density gate: four loop shapes whose bodies cannot arm the EH flag.
// Nothing here calls a may-throw function, so checked mode must emit ZERO
// `__jeti_eh_flag` references for this file (asserted by gen_quality.sh).
// Regression: while/do/for-with-cond used to wrap the condition in
// `(flag == 0) && ...` unconditionally, paying a global read per iteration.
int f_for_cond(void) { int i = 0; for (; i < 5;) i++; return i; }
int f_while(void)    { int i = 0; while (i < 5) i++; return i; }
int f_do(void)       { int i = 0; do { i++; } while (i < 5); return i; }
int f_forever(void)  { int i = 0; for (;;) { i++; if (i >= 5) break; } return i; }

int main() { return f_for_cond() + f_while() + f_do() + f_forever() - 20; }
