#include <ovic/runtime.h>

// Scenario for the "guard-density" gate: a program with NO @try, NO @throw,
// and NO Foundation import (so no inlined throwing method chain).
//
// `-eh checked` must emit ZERO `__ovic_eh_flag` guards here — the stage-3
// effect analysis exists so that a program that cannot throw pays nothing.
// (A Foundation-inlining program does pay guards, but only along real
// @throw-capable call chains — see tests/eh_matrix/README.md.)
//
// Uses the implicit root class + the freestanding-style bump allocator, so the
// generated C is self-contained and minimal.

@interface EhPlain {
    int v;
}
+ (id)alloc;
- (id)init;
- (int)get;
- (void)set:(int)x;
@end

@implementation EhPlain
+ (id)alloc { return ovic_alloc(self); }
- (id)init { return self; }
- (int)get { return v; }
- (void)set: (int)x { v = x; }
@end

int main() {
    EhPlain *p = [[EhPlain alloc] init];
    [p set:7];
    // NOTE: compute first, return the value — deliberately avoiding the
    // `return <expr using an owned local>` shape, which exercises a separate
    // pre-existing ARC ordering defect (release inserted before the return
    // expression is evaluated). That defect is unrelated to -eh and is
    // reported in tests/eh_matrix/README.md.
    int r = [p get] - 7;
    return r;
}
