#import <Foundation/Foundation.gm>

@interface Box<T> : NFObject
- (instancetype)initWithValue:(T)v;
- (T)value;
@end

@implementation Box<T>
{
    T _storage;
}
- (instancetype)initWithValue:(T)v { self = [super init]; if (self) { _storage = v; } return self; }
- (T)value { return _storage; }
@end

@namespace Metal
@interface Wrapped : NFObject
+ (NFString *)unbox;
@end

@implementation Wrapped
+ (NFString *)unbox {
    Box<NFString *> *b = [[Box<NFString *> alloc] initWithValue:@"ns"];
    return [b value];
}
@endnamespace

int main() {
    NFLog(@"ns=%@", [Metal::Wrapped unbox]);
    // 顶层泛型（回归确认）
    Box<NFString *> *sb = [[Box<NFString *> alloc] initWithValue:@"top"];
    NFLog(@"top=%@", [sb value]);
    return 0;
}
