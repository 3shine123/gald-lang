#include <stdio.h>
#import <Foundation/Foundation.gh>

@interface Base : NFObject
- (void)identify;
@end

@interface Derived : Base
- (void)identify;
@end

@implementation Base
- (void)identify {
    printf("Base\n");
}
@end

@implementation Derived
- (void)identify {
    printf("Derived\n");
    [super identify];
}
@end

int main() {
    Derived *d = [[Derived alloc] init];
    [d identify];
    return 0;
}
