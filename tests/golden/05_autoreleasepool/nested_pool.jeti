#include <stdio.h>
#import <Foundation/Foundation.jth>

@interface Item : NPObject
@end

@implementation Item
- (void)dealloc {
    printf("dealloc\n");
}
@end

int main() {
    @autoreleasepool {
        printf("first pool\n");
    }
    @autoreleasepool {
        Item *a = [Item new];
        printf("second pool\n");
    }
    printf("end\n");
    return 0;
}
