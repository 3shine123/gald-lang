#include <stdio.h>
#import <Foundation/Foundation.gh>

@interface Secret : NFObject
- (void)publicMethod;
@end

@interface Secret ()
- (int)privateMethod;
@end

@implementation Secret
- (void)publicMethod {
    printf("public\n");
}
- (int)privateMethod {
    return 42;
}
@end

int main() {
    Secret *s = [[Secret alloc] init];
    [s publicMethod];
    int val = [s privateMethod];
    printf("secret=%d\n", val);
    return 0;
}
