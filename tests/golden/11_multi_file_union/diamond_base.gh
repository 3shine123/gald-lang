// lang-test/diamond_base.gh
// 菱形继承与多重协议的前置声明文件

#import <Foundation/Foundation.gh>

// 1. 菱形继承协议网
@protocol NFBaseProtocol <NFObject>
- (void)executeCoreTask;
@end

@protocol NFLeftProtocol <NFBaseProtocol>
- (void)leftBranchAction;
@end

@protocol NFRightProtocol <NFBaseProtocol>
- (void)rightBranchAction;
@end

// 2. 两个互相引用的类的前置声明（打破文件包含死锁）
@class NFCraftPilot;
@interface NFShipSystem : NFObject
{
    @public
    // 互引用指针，测试编译器在未完全解析 NFCraftPilot 时对指针大小和符号的计算
    NFCraftPilot* currentPilot; 
    int systemStatusId;
}
- (id)initWithId:(int)sid;
- (void)linkPilot:(id)pilot;
@end