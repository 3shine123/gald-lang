// test: NFLog basic output
#include <stdio.h>
#import <Foundation/Foundation.np>

int main() {
    @autoreleasepool {
        NFLog(@"hello world");
        NFLog(@"number: %d", 100);
        NFLog(@"string: %s", "test");
        NFLog(@"percent: 50%%");
    }
    printf("NFLog basic OK\n");
    return 0;
}