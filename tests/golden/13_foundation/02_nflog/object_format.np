// test: NFLog %% with objects
#include <stdio.h>
#import <Foundation/Foundation.np>

@interface Foo : NFObject
- (id)init;
@end
@implementation Foo
- (id)init { self = [super init]; return self; }
@end

int main() {
    @autoreleasepool {
        Foo *f = [[Foo alloc] init];
        NFLog(@"obj: %@", f);
        NFLog(@"null: %@", (void *)0);
        [f release];
    }
    printf("NFLog %% OK\n");
    return 0;
}