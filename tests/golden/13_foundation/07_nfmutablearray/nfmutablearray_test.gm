#include <stdio.h>
#import <Foundation/Foundation.gh>

int main() {
    @autoreleasepool {
        // 1. arrayWithCapacity: + addObject: + inherited queries
        NFMutableArray *m = [NFMutableArray arrayWithCapacity:2];
        [m addObject:@"a"];
        [m addObject:@"b"];
        [m addObject:@"c"];
        printf("count=%zu [0]=%s [2]=%s first=%s last=%s\n",
            [m count],
            [[m objectAtIndex:0] UTF8String],
            [[m objectAtIndex:2] UTF8String],
            [[m firstObject] UTF8String],
            [[m lastObject] UTF8String]);

        // 2. insertObject:atIndex:
        [m insertObject:@"X" atIndex:1];
        printf("count=%zu [1]=%s\n", [m count], [[m objectAtIndex:1] UTF8String]);

        // 3. replaceObjectAtIndex:withObject: / setObject:atIndex:
        [m replaceObjectAtIndex:2 withObject:@"Y"];
        [m setObject:@"Z" atIndex:0];
        printf("[0]=%s [1]=%s [2]=%s\n",
            [[m objectAtIndex:0] UTF8String],
            [[m objectAtIndex:1] UTF8String],
            [[m objectAtIndex:2] UTF8String]);

        // 4. exchangeObjectAtIndex:withObjectAtIndex:
        [m exchangeObjectAtIndex:0 withObjectAtIndex:2];
        printf("exchanged [0]=%s [2]=%s\n",
            [[m objectAtIndex:0] UTF8String], [[m objectAtIndex:2] UTF8String]);

        // 5. removeObjectAtIndex: / removeLastObject / removeObject:
        NFString *x = @"X";
        [m removeObjectAtIndex:0];
        [m removeLastObject];
        [m removeObject:x];
        printf("count=%zu contains X=%d\n", [m count], [m containsObject:x]);

        // 6. addObjectsFromArray: + arrayWithObject:
        NFMutableArray *other = [NFMutableArray arrayWithObject:@"tail"];
        [m addObjectsFromArray:other];
        printf("count=%zu last=%s\n", [m count], [[m lastObject] UTF8String]);

        // 7. removeAllObjects
        [m removeAllObjects];
        printf("count=%zu\n", [m count]);

        // 8. alloc + initWithArray: + initWithCapacity:
        NFMutableArray *seed = [NFMutableArray arrayWithCapacity:0];
        [seed addObject:@"p"];
        [seed addObject:@"q"];
        NFMutableArray *m2 = [[NFMutableArray alloc] initWithArray:seed];
        printf("m2 count=%zu desc=%s\n", [m2 count], [[m2 description] UTF8String]);

        // 9. arrayWithObjects:count:
        id objs[3];
        objs[0] = @"p";
        objs[1] = @"q";
        objs[2] = @"r";
        NFMutableArray *m3 = [NFMutableArray arrayWithObjects:objs count:3];
        printf("m3 count=%zu [2]=%s\n", [m3 count], [[m3 objectAtIndex:2] UTF8String]);

        // 10. copy returns an immutable NFArray (released by ARC)
        NFArray *imm = [m3 copy];
        printf("imm count=%zu\n", [imm count]);
    }
    return 0;
}