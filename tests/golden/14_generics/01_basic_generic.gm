#include <stdio.h>
#import <Foundation/Foundation.gh>

@interface Box<T> : NFObject {
    @public
    T _value;
}
- (void)setValue:(T)val;
- (T)value;
@end

@implementation Box
- (void)setValue:(T)val {
    _value = val;
}
- (T)value {
    return _value;
}
@end

@interface Wrapper : NFObject
@end
@implementation Wrapper
@end

int main() {
    @autoreleasepool {
        Box<Wrapper*> *box = [[Box alloc] init];
        printf("Box<Wrapper*> created\n");
    }
    return 0;
}