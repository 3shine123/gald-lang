#include <stdio.h>

__asm__(".section .note.nopa_asm, \"a\"");

int main() {
    // Basic asm
    asm("nop");

    // Extended asm: output + inputs + clobbers
    int a = 10, b = 20, out = 0;
    asm volatile("add %w0, %w1, %w2\n\t"
                 "sub %w0, %w0, #1"
                 : "=r"(out)
                 : "r"(a), "r"(b)
                 : "cc");
    printf("extended: out=%d\n", out);

    // Named operands
    int v = 7, shifted = 0;
    asm("mov %w[res], %w[val]\n\t"
        "lsl %w[res], %w[res], #2"
        : [res] "=r"(shifted)
        : [val] "r"(v)
        : "cc");
    printf("named: shifted=%d\n", shifted);

    // Read-write operand
    int w = 3;
    asm("lsl %w0, %w0, #2" : "+r"(w));
    printf("rw: w=%d\n", w);

    // asm goto
    int x = 0;
    asm goto("cmp %w0, #0\n\tb.eq %l[zero]" : : "r"(x) : "cc" : zero);
    goto skip;
zero:
    printf("goto: zero reached\n");
skip:
    printf("goto: done\n");
    return 0;
}
