// freestanding.np — bare-metal golden test
// Demonstrates every Nopa feature usable without Foundation/libc.
// Compile: nopac -rewrite-nopa -fno-libc, then clang -U__NOPA_FREESTANDING
// (on the host we use libc's setjmp/longjmp, not builtins).

extern void kputs(const char* s);
extern void kputdec(int v);
extern void kputhex(unsigned v);

extern BareMetal::Calculator   *create_calculator(void);
extern BareMetal::NFIoError  *create_error(int code);

@namespace BareMetal

    @interface Calculator {
        int total;
    }
    + (int) compute:(int)x;
    - (int) add:(int)x;
    - (int) value;
    @end

    @implementation Calculator
    + (int) compute:(int)x { return x * 2 + 1; }
    - (int) add:(int)x     { total += x; return total; }
    - (int) value          { return total; }
    @end

    @interface NFIoError {
        int code;
    }
    - (int) errorCode;
    @end

    @implementation NFIoError
    - (int) errorCode { return code; }
    @end

    @interface Counter {
        int total;
    }
    + (id) alloc;
    - (id) init;
    - (int) add:(int)x;
    - (int) value;
    @end

    @implementation Counter
    + (id) alloc {
        return nopa_alloc(self);
    }
    - (id) init {
        return self;
    }
    - (int) add:(int)x     { total += x; return total; }
    - (int) value          { return total; }
    @end
@endnamespace

int main() {
    nopa_meta_init();

    kputs("=== freestanding golden test ===\n");

    // ── 1. @namespace + @interface (implicit root) ──
    kputs("[1] @namespace + @interface (implicit root):\n");
    kputs("    class method [BareMetal::Calculator compute:21] = ");
    kputdec([BareMetal::Calculator compute:21]);
    kputs("\n");

    BareMetal::Calculator *acc = create_calculator();
    kputs("    instance: add:7=");
    kputdec([acc add:7]);
    kputs(" add:35=");
    kputdec([acc add:35]);
    kputs(" value=");
    kputdec([acc value]);
    kputs("\n");

    // ── 2. Alloc + init (heap-allocated via bump allocator) ──
    BareMetal::Counter *c = [[BareMetal::Counter alloc] init];
    kputs("[2] alloc+init (bump allocator):\n");
    kputs("    [c add:10]=");
    kputdec([c add:10]);
    kputs(" [c add:20]=");
    kputdec([c add:20]);
    kputs(" [c value]=");
    kputdec([c value]);
    kputs("\n");

    // ── 3. @try/@catch/@finally ──
    BareMetal::NFIoError *err = create_error(42);
    kputs("[3] @try/@catch/@finally:\n");
    kputs("    try body, throwing...\n");
    @try {
        @throw err;
        kputs("    unreachable\n");
    } @catch(id e) {
        kputs("    caught [e errorCode] = ");
        kputdec([e errorCode]);
        kputs("\n");
    } @finally {
        kputs("    finally always runs\n");
    }
    kputs("    after-try continues\n");

    // ── 4. Inline asm (cross-platform no-op barrier) ──
    {
        int x = 42;
        asm volatile("" : "+r"(x));
        kputs("[4] inline asm: no-op barrier OK\n");
    }

    // ── 5. @selector ──
    SEL s = @selector(compute:);
    kputs("[5] @selector: name=");
    kputs(s.name);
    kputs(" hash=0x");
    kputhex(s.hash);
    kputs("\n");

    // ── 6. C-style cast ──
    {
        void *p = 0;
        int *ip = (int *)p;
        (void)ip;
        kputs("[6] C-style cast: (int *)p OK\n");
    }

    kputs("PASS\n");
    return 0;
}