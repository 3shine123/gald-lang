#include "nopa/runtime.h"
#import "Foundation/NPObject.nh"
#import "Foundation/NPObject.np"

@interface Item : NPObject {
    int _tag;
}
- (int)tag;
@end

@implementation Item

- (int)tag {
    return _tag;
}

@end

int main() {
    @noarc {
        @autoreleasepool {
            @autoreleasepool {
                Item *inner = [Item new];
                [inner autorelease];
            }
            Item *outer = [Item new];
            [outer autorelease];
        }
    }
    return 0;
}
