#include "ovel/runtime.h"
#import "Foundation/NPObject.oh"
#import "Foundation/NPObject.ov"

@interface Item : NPObject {
    int _tag;
}
- (int)tag;
@end

@implementation Item

- (int)tag {
    return _tag;
}

@end

int main() {
    int cond = 1;
    @noarc {
        Item *branch = [Item new];
        if (cond) {
            [branch retain];
            [branch release];
            [branch release];
        } else {
            [branch release];
        }
    }
    return 0;
}
