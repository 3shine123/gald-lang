#include "gald/runtime.h"
#import "Foundation/NFObject.gh"
#import "Foundation/NFObject.gm"

@interface Item : NFObject {
    int _tag;
}
- (int)tag;
@end

@implementation Item

- (int)tag {
    return _tag;
}

@end

int main() {
    @noarc {
        Item *leak = [Item new];
        Item *ok = [Item new];
        [ok release];
    }
    return 0;
}
