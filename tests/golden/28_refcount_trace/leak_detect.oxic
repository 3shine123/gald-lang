#include "nepa/runtime.h"
#import "Foundation/NPObject.nh"
#import "Foundation/NPObject.np"

@interface Item : NPObject {
    int _tag;
}
- (int)tag;
@end

@implementation Item

- (int)tag {
    return _tag;
}

@end

int main() {
    @noarc {
        Item *leak = [Item new];
        Item *ok = [Item new];
        [ok release];
    }
    return 0;
}
