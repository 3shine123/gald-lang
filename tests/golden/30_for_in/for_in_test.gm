#include <stdio.h>
#import <Foundation/Foundation.gh>

int main() {
    @autoreleasepool {
        NFArray *arr = @[ @"one", @"two", @"three" ];

        // for-in over an NFArray: loop var is a fresh NFObject* per iteration
        int idx = 0;
        for (NFObject *x in arr) {
            idx = idx + 1;
            printf("%d: %s\n", idx, [(NFString *)x UTF8String]);
        }

        // nested for-in
        NFArray *rows = @[ @[ @"a", @"b" ], @[ @"c", @"d" ] ];
        for (NFObject *row in rows) {
            for (NFObject *cell in (NFArray *)row) {
                printf("cell %s\n", [(NFString *)cell UTF8String]);
            }
        }

        // empty array: body must not run
        NFArray *empty = [NFArray array];
        int hits = 0;
        for (NFObject *e in empty) {
            hits = hits + 1;
        }
        printf("empty hits: %d\n", hits);
    }
    printf("for-in done\n");
    return 0;
}
