#import <Foundation/Foundation.gh>

// NFAsync<T> declaration marker (AGENTS.md `NFAsync<T>` section):
// - `- (NFAsync<T>)m` marks a suspending method. The parser unwraps the
//   marker to `T` + an async_marker flag — pure compile-time metadata: the
//   emitted C signature is just `T` (verified: `NFAsync` appears 0 times in
//   the generated C).
// - Reconciliation (gald_async::check_unit, pre-desugar):
//     marked + @await    → ok
//     marked, no @await  → error ("the marker must not lie")
//     await, unmarked    → warning (-Werror escalates)
//     unmarked, no await → ok
// - @interface and @implementation must agree — the marker is part of the
//   method signature.
// Negative cases live in tests/negative/async_marker_*.gm

@interface Fetcher : NFObject
- (NFAsync<int>)compute:(int)n;
+ (NFAsync<void>)runAll;
- (int)plain:(int)n;             // unmarked + no @await → ok
@end

@implementation Fetcher
- (NFAsync<int>)compute:(int)n {
    int raw = @await n;          // suspension point
    return raw * 2;
}
+ (NFAsync<void>)runAll {
    Fetcher *f = [[Fetcher alloc] init];
    int x = @await [f compute:21];   // await across a call chain
    int y = [f plain:5];             // plain sync call, no marker involved
    printf("runAll x=%d y=%d\n", x, y);
}
- (int)plain:(int)n {
    return n + 1;
}
@end

int main() {
    [Fetcher runAll];            // async void entry: blocking wrapper
    return 0;
}
