// NFArray<T> true monomorphization: objectAtIndex: returns T, addObject takes T.
// Bare NFArray (no args) keeps erased behavior.
#import <Foundation/Foundation.gh>

int main() {
    // Immutable typed array
    NFArray<NFString *> *a = [NFArray<NFString *> arrayWithObject:@"hello"];
    NFString *s = [a objectAtIndex:0];
    NFLog(@"first=%@", s);

    // Mutable typed array (generic inheritance NFMutableArray<T> : NFArray<T>)
    NFMutableArray<NFString *> *m = [[NFMutableArray<NFString *> alloc] init];
    [m addObject:@"alpha"];
    [m addObject:@"beta"];
    NFString *e = [m objectAtIndex:1];
    NFLog(@"elem=%@ count=%lu", e, [m count]);

    // Bare spelling: zero migration, erased behavior unchanged
    NFMutableArray *bare = [NFMutableArray array];
    [bare addObject:@"x"];
    [bare addObject:@42];
    NFLog(@"bare count=%lu", [bare count]);
    return 0;
}
