#import <Foundation/Foundation.gh>

/* Namespaces across TUs: `::` is encoded as `__` in C symbols, so a class
   defined in the lib TU under a namespace must still be reachable from the
   client TU that only ever saw the short qualified name.

   Note: ivars are declared on the @interface (Nupa's convention — the
   @implementation body is for methods, not for a second ivar list). */
@namespace Geo
    @interface Point : NFObject {
        @public
        int _x;
        int _y;
    }
    - (int)x;
    - (int)y;
    - (int)magnitude;
    @end

    @interface Origin : Point
    @end
@endnamespace

int GeoHelper(void);
