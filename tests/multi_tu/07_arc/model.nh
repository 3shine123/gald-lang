#import <Foundation/Foundation.np>

/* ARC across TUs: the lib TU hands out an object the client then owns, and
   the client allocates objects it releases. Compile-time ARC insertion must
   stay correct when the two halves were transpiled separately. */
@interface Vault : NFObject
- (int)total;
@end

NFString *VaultToken(void);
int VaultHelper(void);
