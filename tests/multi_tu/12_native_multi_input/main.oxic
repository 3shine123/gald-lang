#import "model.nh"
#import <Foundation/Foundation.np>
#include <stdio.h>

/* client TU: sees only the .nh, never lib.np */
int main() {
    Greeter *g = [[Greeter alloc] init];
    printf("%s\n", [g greeting:"world"]);
    printf("count=%d\n", [g count]);
    printf("helper=%d\n", GreeterHelper(41));
    nepa_release(g);
    return 0;
}
