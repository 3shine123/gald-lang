#import <Foundation/Foundation.np>
// EXPECT_FAIL: sync context (main) calling a non-void async method
// → cannot call suspending method 'compute:' from non-async context
@interface F : NPObject
- (int)compute:(int)n;
@end
@implementation F
- (int)compute:(int)n { int r = @await n; return r; }
@end
int main() { F *f = [[F alloc] init]; return [f compute:1]; }
