// NEGATIVE test — must FAIL to compile.
//
// `@(...)` picks an NFNumber factory from the operand's static type, so only
// arithmetic and BOOL operands can be boxed. ObjC would box an NSNumber from an
// NSString, but Gald has no string boxing; silently emitting the pointer where a
// number is expected would hide the mistake, so the checker rejects it.
#import <Foundation/Foundation.gh>

int main(void) {
    NFString *s = @"hi";
    NFNumber *n = @(s);   // error: illegal type 'NFString *' in a boxed expression
    NFLog(@"%@", n);
    return 0;
}
