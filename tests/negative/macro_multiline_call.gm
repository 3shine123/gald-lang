// negative: gald macro invocation not closed on one line
// galdc must refuse with a clear error (multi-line calls unsupported).
#import <Foundation/Foundation.gh>
#include <stdio.h>

#define TAG(o) [o tag]

int main() {
    gald_meta_init();
    NFObject *w = (NFObject *)0;
    // call split across lines — unsupported
    printf("%d\n", TAG(
        w));
    return 0;
}
