// negative: nepa macro invocation not closed on one line
// nepac must refuse with a clear error (multi-line calls unsupported).
#import <Foundation/Foundation.np>
#include <stdio.h>

#define TAG(o) [o tag]

int main() {
    nepa_meta_init();
    NPObject *w = (NPObject *)0;
    // call split across lines — unsupported
    printf("%d\n", TAG(
        w));
    return 0;
}
