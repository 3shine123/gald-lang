#import <Foundation/Foundation.np>

// Negative: `case [obj msg]:` is not a C constant expression. It used to leak
// into the emitted C verbatim (`case <message send>:`), so the error pointed
// into generated code with no source correspondence. The parser must report it
// at the source location instead. Expected: exit=1 with
//   "case label is not a constant expression"
int main(void) {
    NFObject *o = @42;
    int r = 0;
    switch (r) {
        case [o description]:
            r = 1;
            break;
        default:
            r = 9;
    }
    NFLog(@"r=%d", r);
    return 0;
}
