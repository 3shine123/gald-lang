// negative — `#if` without `#endif` must be rejected.
//
// The guard directives themselves never reach clang (jetic consumes them), so an
// unclosed conditional would silently swallow the rest of the file and the only
// visible symptom would be a confusing "no main" / "unknown type" further down.
// jetic reports the real cause instead:
//   t.jeti: unterminated conditional directive — 1 #if without #endif
#if 0
int main() { return 0; }
