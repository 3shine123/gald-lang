#include <stdio.h>
#include <string.h>
#import <Foundation/Foundation.np>

int main() {
    @autoreleasepool {

        printf("─── 1. @\"\" Literal ───\n");
        NFString *s1 = @"Hello";
        printf("  literal: %s\n", [s1 UTF8String]);
        printf("  length: %zu\n", [s1 length]);

        printf("─── 2. Factory Methods ───\n");
        NFString *s2 = [NFString stringWithUTF8String:"NFString"];
        NFString *s3 = [NFString stringWithString:s2];
        printf("  from cstr: %s\n", [s2 UTF8String]);
        printf("  from copy: %s\n", [s3 UTF8String]);

        printf("─── 3. Concatenation ───\n");
        NFString *s4 = [[s1 stringByAppendingUTF8String:" "] stringByAppendingString:s2];
        printf("  concat: %s\n", [s4 UTF8String]);
        printf("  len: %zu\n", [s4 length]);

        printf("─── 4. Comparison ───\n");
        printf("  equal Hello: %s\n", [s1 isEqualToString:@"Hello"] ? "YES" : "NO");
        printf("  equal World: %s\n", [s1 isEqualToString:@"World"] ? "YES" : "NO");
        printf("  compare Apple: %d\n", [s1 compare:@"Apple"]);

        printf("─── 5. Prefix / Suffix ───\n");
        NFString *he = [NFString stringWithUTF8String:"He"];
        NFString *ng = [NFString stringWithUTF8String:"ing"];
        printf("  hasPrefix He: %s\n", [s4 hasPrefix:he] ? "YES" : "NO");
        printf("  hasSuffix ing: %s\n", [s4 hasSuffix:ng] ? "YES" : "NO");

        printf("─── 6. Substring ───\n");
        NFString *sub1 = [s4 substringFromIndex:6];
        printf("  from 6: %s\n", [sub1 UTF8String]);
        NFString *sub2 = [s4 substringToIndex:5];
        printf("  to 5: %s\n", [sub2 UTF8String]);
        NFString *sub3 = [s4 substringWithRange:(NFRange){6, 7}];
        printf("  range(6,7): %s\n", [sub3 UTF8String]);

        printf("─── 7. Range ───\n");
        NFRange r = [s4 rangeOfString:[NFString stringWithUTF8String:"NFString"]];
        printf("  range of NFString: loc=%zu len=%zu\n", r.location, r.length);
        NFRange r2 = [s4 rangeOfString:[NFString stringWithUTF8String:"NotFound"]];
        printf("  not found: loc=%zu\n", r2.location);

        printf("─── 8. Case Transform ───\n");
        NFString *upper = [s1 uppercaseString];
        NFString *lower = [upper lowercaseString];
        printf("  upper: %s\n", [upper UTF8String]);
        printf("  lower: %s\n", [lower UTF8String]);

        printf("─── 9. Hash ───\n");
        printf("  hash: %u\n", [s1 hash]);
        printf("  hash same: %u\n", [@"Hello" hash]);

        printf("─── 10. charAtIndex ───\n");
        for (int i = 0; i < [s1 length]; i++) {
            printf("  [%d] = '%c'\n", i, [s1 characterAtIndex:i]);
        }

        printf("─── 11. Empty String ───\n");
        NFString *empty = [NFString stringWithUTF8String:""];
        printf("  empty len: %zu\n", [empty length]);
        printf("  empty str: '%s'\n", [empty UTF8String]);

        printf("─── 12. @\"\" vs Factory ───\n");
        NFString *fac = [NFString stringWithUTF8String:"NFString"];
        printf("  equal: %s\n", [@"NFString" isEqualToString:fac] ? "YES" : "NO");

        printf("─── 13. Chained ───\n");
        NFString *chain = [[[[NFString stringWithUTF8String:"a"] stringByAppendingUTF8String:"b"]
            stringByAppendingUTF8String:"c"] stringByAppendingUTF8String:"d"];
        printf("  chain: %s\n", [chain UTF8String]);

        printf("─── 14. Copy ───\n");
        NFString *cp = [s1 copy];
        printf("  copy: %s\n", [cp UTF8String]);
        printf("  copy equal: %s\n", [cp isEqualToString:s1] ? "YES" : "NO");

        printf("─── 15. Description ───\n");
        NFString *desc = [s1 description];
        printf("  desc: %s\n", [desc UTF8String]);

        printf("─── 16. @\"\" as argument ───\n");
        NFString *target = [NFString stringWithUTF8String:"World"];
        NFString *greeting = [[NFString stringWithUTF8String:"Hello"]
            stringByAppendingUTF8String:", "];
        NFString *result = [greeting stringByAppendingString:target];
        printf("  result: %s\n", [result UTF8String]);

        printf("─── 17. Substring Edge ───\n");
        NFString *fs = [@"NFString" substringFromIndex:0];
        NFString *fe = [@"NFString" substringToIndex:7];
        NFString *fr = [@"NFString" substringWithRange:(NFRange){0, 7}];
        printf("  from 0: %s\n", [fs UTF8String]);
        printf("  to 7: %s\n", [fe UTF8String]);
        printf("  range(0,7): %s\n", [fr UTF8String]);

        printf("─── 18. NFLog with NFString ───\n");
        NFLog(@"NFString value: %s", [s4 UTF8String]);

        printf("─── 19. Large string ───\n");
        NFString *large = [NFString stringWithUTF8String:"The quick brown fox jumps over the lazy dog."];
        printf("  large len: %zu\n", [large length]);
        printf("  large first 20: %s\n", [[large substringToIndex:20] UTF8String]);

        printf("─── 20. Multiple At-String args ───\n");
        NFString *a = @"Hello";
        NFString *b = @"World";
        NFString *ab = [[a stringByAppendingUTF8String:", "] stringByAppendingString:b];
        printf("  %s\n", [ab UTF8String]);
    }
    return 0;
}