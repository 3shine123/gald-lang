#include <stdio.h>
#import <Foundation/Foundation.np>

@interface Gizmo : NFObject {
    @public int _x;
}
- (int) value;
- (void) setValue:(int)v;
- (NFString *) name;
- (NFRange) bounds;
@end

@implementation Gizmo
- (int) value { return _x; }
- (void) setValue:(int)v { _x = v; }
- (NFString *) name { return nil; }
- (NFRange) bounds { NFRange r; r.location = 3; r.length = 9; return r; }
@end

int main() {
    @autoreleasepool {
        Gizmo *g = [Gizmo new];
        [g setValue:41];
        NFLog(@"g.value = %d", [g value]);

        // 1. nil receiver, value-returning send → returns 0, does not crash.
        Gizmo *n = nil;
        int v = [n value];
        NFLog(@"nil value send = %d", v);

        // 2. nil receiver, void-returning send → safe no-op.
        [n setValue:7];
        NFLog(@"after nil void send");

        // 3. nil receiver, struct-returning send → zeroed struct.
        NFRange b = [n bounds];
        NFLog(@"nil bounds = (%zu,%zu)", b.location, b.length);

        // 4. chained sends with a nil intermediate → safe zero, no crash.
        NFString *s = [[[n name] stringByAppendingUTF8String:"x"] stringByAppendingUTF8String:"y"];
        NFLog(@"nil chain = %p", s);

        // 5. non-nil chain still works correctly.
        NFString *ok = [[[g name] stringByAppendingUTF8String:"a"] stringByAppendingUTF8String:"b"];
        NFLog(@"nil->chain ok = %p (g.name returns nil, so this is 0 too)", ok);

        // 6. literal nil receiver.
        int z = [nil value];
        NFLog(@"literal nil send = %d", z);

        NFLog(@"all nil-messaging tests done");
    }
    return 0;
}
