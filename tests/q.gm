#include <stdio.h>
#import <Foundation/Foundation.gh>

@namespace Student
    @interface Person : NFObject 

    - (void)speak;

    @end

    @implementation Person

    - (void)speak {
        printf("Hello, Gald world!\n");
    }

    @end

    @interface Student : Person

    - (void)talk;

    @end

    @implementation Student

    - (void)talk {
        [super speak];
    }

    @end
@endnamespace

int main(int argc, const char * argv[]) {
    @autoreleasepool {
        Student::Student *s = [[Student::Student alloc] init];
        [s talk];
        NFArray *arr = [NFArray arrayWithObjects:@1, @2, @3, nil];
        NFLog(@"Array: %@", arr);
    }
    return 0;
}