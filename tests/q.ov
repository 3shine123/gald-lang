#include <stdio.h>
#import <Foundation/Foundation.ov>

@namespace Student
    @interface Person : NPObject 

    - (void)speak;

    @end

    @implementation Person

    - (void)speak {
        printf("Hello, Ovic world!\n");
    }

    @end

    @interface Student : Person

    - (void)talk;

    @end

    @implementation Student

    - (void)talk {
        [super speak];
    }

    @end
@endnamespace

int main(int argc, const char * argv[]) {
    @autoreleasepool {
        Student::Student *s = [[Student::Student alloc] init];
        [s talk];
        NPArray *arr = [NPArray arrayWithObjects:@1, @2, @3, nil];
        NPLog(@"Array: %@", arr);
    }
    return 0;
}