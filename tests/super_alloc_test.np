// Super class-method dispatch: `[super msg]` inside a class method (+)
// must dispatch through the PARENT's meta vtable (`class_vtable`), not the
// uniform instance vtable (which has no class-method members → invalid C).
#import <Foundation/Foundation.np>

@interface Animal : NFObject
+ (NFString *)kingdom;
@end

@implementation Animal
+ (NFString *)kingdom { return @"Animalia"; }
@end

@interface Dog : Animal
+ (NFString *)kingdom;
+ (id)makeInstance;
@end

@implementation Dog
// super INSTANCE-class method: parent meta vtable slot
+ (NFString *)kingdom { return [super kingdom]; }
// super alloc: parent meta vtable alloc slot (inherited from NFObject)
+ (id)makeInstance { return [super alloc]; }
@end

int main() {
    NFLog(@"kingdom=%@", [Dog kingdom]);      // super kingdom → Animalia
    id d = [Dog makeInstance];                 // super alloc → non-null
    NFLog(@"alloc=%s", d ? "ok" : "null");
    return 0;
}
