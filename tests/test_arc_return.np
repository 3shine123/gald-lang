#include <stdio.h>
#import <Foundation/Foundation.np>

@interface Obj : NFObject
- (void)doSomething;
@end
@implementation Obj
- (void)doSomething { printf("done\n"); }
@end

NFObject * test_early_return(int cond) {
    id obj = [[Obj alloc] init];
    if (cond) return nil;  // obj must be released before this return
    [obj doSomething];
    return obj;
}

int main() {
    @autoreleasepool {
        id r = test_early_return(0);
        [r release];
    }
    return 0;
}