// NFKeywordTest.h -> 专为测试 @ 关键字编写的进阶工具类
// 基于 NFFoundation 框架的 Objective-C 风格高阶测试

#import <Foundation/Foundation.gm>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// ============ 1. @protocol 关键字测试 ============
// 测试编译器对“协议/接口”定义以及可选/必选方法的解析
@protocol NFCollectionDelegate <NFObject>
@required
- (void)collectionDidReachCapacity:(id)collection;
@optional
- (void)collection:(id)collection didAddItem:(id)item;
@end


// ============ 2. @class 关键字测试 ============
// 前置声明，测试编译器在未完全解析该类时对指针类型的容错能力
@class NFDataNode;


// ============ 3. 核心数据类定义 ============
@interface NFDataNode : NFObject
{
    // 测试 @protected / @private / @public 访问权限关键字
    @private
    const char* _key;
    id _value;
    
    @protected
    NFDataNode* _nextNode;
}

// 测试 @property 关键字及其属性修饰符（nonatomic, retain, copy, assign 等）
@property (nonatomic, copy) const char* key;
@property (nonatomic, retain) id value;
@property (nonatomic, retain) NFDataNode* nextNode;

- (id)initWithKey:(const char *)k value:(id)v;
@end

@implementation NFDataNode

// 测试 @synthesize 关键字，看编译器能否自动生成 getter/setter 符号
@synthesize key = _key;
@synthesize value = _value;
@synthesize nextNode = _nextNode;

- (id)initWithKey:(const char*)k value:(id)v
{
    self = [super init];
    if (self) {
        _key = k;
        _value = v;
        _nextNode = nil;
    }
    return self;
}

- (void)dealloc
{
    if (_nextNode) {
        [_nextNode release];
    }
    [super dealloc];
}
@end


// ============ 4. 高级工具箱：带代理通知的容器类 ============
@interface NFDataContainer : NFObject
{
    @private
    NFDataNode* _headNode;
    int _count;
    int _maxCapacity;
    
    // 测试协议类型的声明语法 (id<Protocol>)
    id<NFCollectionDelegate> _delegate;
}

@property (nonatomic, assign) int maxCapacity;
@property (nonatomic, readonly) int count;
// 代理通常用 assign/weak 避免循环引用
@property (nonatomic, assign) id<NFCollectionDelegate> delegate;

- (id)initWithCapacity:(int)capacity;
- (BOOL)setObject:(id)obj forKey:(const char*)key;
- (id)objectForKey:(const char*)key;
- (void)performSelectorTest:(const char*)selectorName;
@end

@implementation NFDataContainer

@synthesize maxCapacity = _maxCapacity;
@synthesize count = _count;
@synthesize delegate = _delegate;

- (id)initWithCapacity:(int)capacity
{
    self = [super init];
    if (self) {
        _maxCapacity = capacity;
        _count = 0;
        _headNode = nil;
        _delegate = nil;
    }
    return self;
}

- (BOOL)setObject:(id)obj forKey:(const char*)key
{
    // 检查容量限制，触发 @required 协议方法
    if (_count >= _maxCapacity) {
        if (_delegate != nil) {
            // 模拟协议方法调用
            [_delegate collectionDidReachCapacity:self];
        }
        return NO;
    }

    NFDataNode* newNode = [[NFDataNode alloc] initWithKey:key value:obj];
    if (_headNode != nil) {
        [newNode setNextNode:_headNode];
    }
    _headNode = newNode;
    _count++;

    // 触发 @optional 协议方法验证
    if (_delegate != nil) {
        // 实际 ObjC 会用 respondsToSelector: 判断，这里简化为直接通知
        [_delegate collection:self didAddItem:obj];
    }
    return YES;
}

- (id)objectForKey:(const char*)key
{
    NFDataNode* current = _headNode;
    while (current != nil) {
        if (strcmp([current key], key) == 0) {
            return [current value];
        }
        current = [current nextNode];
    }
    return nil;
}

// 测试 @selector 关键字的解析
- (void)performSelectorTest:(const char*)selectorName
{
    // 模拟将字符串或硬编码符号转化为选择器
    // 你的编译器如果支持 @selector(methodName)，可以在这里进行断言测试
    printf("[容器日志] 正在尝试解析动态指令: @selector(%s)\n", selectorName);
}

- (void)dealloc
{
    if (_headNode) {
        [_headNode release];
    }
    [super dealloc];
}
@end


// ============ 5. 业务实现类：遵守协议的代理监听器 ============
// 测试遵守协议的语法：@interface ClassName : BaseClass <ProtocolName>
@interface NFCollectionInspector : NFObject <NFCollectionDelegate>
{
    const char* _inspectorName;
}
- (id)initWithName:(const char*)name;
@end

@implementation NFCollectionInspector

- (id)initWithName:(const char*)name
{
    self = [super init];
    if (self) {
        _inspectorName = name;
    }
    return self;
}

// 实现 @required 协议方法
- (void)collectionDidReachCapacity:(id)collection
{
    NFDataContainer* container = (NFDataContainer*)collection;
    printf("[%s 报告] 警告：容器已满！当前数量: %d, 最大容量: %d\n", 
           _inspectorName, [container count], [container maxCapacity]);
}

// 实现 @optional 协议方法
- (void)collection:(id)collection didAddItem:(id)item
{
    printf("[%s 报告] 成功捕获入库事件，新元素地址: %p\n", _inspectorName, item);
}
@end


// ============ 6. 程序入口 ============
int main(int argc, const char* argv[])
{
    // 测试 @autoreleasepool 关键字
    @autoreleasepool {
        printf(">>> 开始 NFFoundation 关键字密集型压力测试 <<<\n\n");

        // 1. 初始化监听器与容器
        NFCollectionInspector* inspector = [[NFCollectionInspector alloc] initWithName:"核心审计器"];
        NFDataContainer* container = [[NFDataContainer alloc] initWithCapacity:2];
        
        // 设置代理
        [container setDelegate:inspector];

        // 2. 准备一些模拟测试数据对象
        NFObject* dummyData1 = [[NFObject alloc] init];
        NFObject* dummyData2 = [[NFObject alloc] init];
        NFObject* dummyData3 = [[NFObject alloc] init];

        // 3. 压入数据（前两次应该成功并触发 didAddItem，第三次应该失败并触发 didReachCapacity）
        printf("--- 尝试插入元素 1 ---\n");
        [container setObject:dummyData1 forKey:"EngineToken"];

        printf("\n--- 尝试插入元素 2 ---\n");
        [container setObject:dummyData2 forKey:"WeaponToken"];

        printf("\n--- 尝试插入元素 3 (预期触发容量报警) ---\n");
        BOOL success = [container setObject:dummyData3 forKey:"ShieldToken"];
        if (!success) {
            printf("[主程序] 元素 3 插入失败，阻断机制正常工作。\n");
        }

        // 4. @selector 编译标记测试
        printf("\n--- 运行时选择器解析测试 ---\n");
        [container performSelectorTest:"collectionDidReachCapacity:"];

        // 5. 内存释放
        printf("\n>>> 正在按引用计数释放对象... <<<\n");
        [dummyData1 release];
        [dummyData2 release];
        [dummyData3 release];
        [container release];
        [inspector release];

        printf(">>> 所有 @ 关键字语法测试顺利结束！ <<<\n");
    }
    return 0;
}